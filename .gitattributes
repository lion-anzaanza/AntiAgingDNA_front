# Normalise line endings so a Windows checkout and a macOS/Linux one produce the
# same blobs. Without this, the first commit from another platform shows every
# file as modified.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary

# Generated — collapse in diffs and reviews.
package-lock.json linguist-generated=true
